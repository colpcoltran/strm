# ------------------------------------------------------------
# Technická bezpečnost – landing page (Apache, sdílený hosting)
# ------------------------------------------------------------

AddDefaultCharset UTF-8
DirectoryIndex index.html index.php

# Přesměrování na HTTPS (výjimka pro ověření Let's Encrypt).
# Podmínka na X-Forwarded-Proto brání smyčce přesměrování, když TLS
# terminuje proxy před Apachem (proxy cache hostingu, Cloudflare…).
<IfModule mod_rewrite.c>
RewriteEngine On

# Kanonický host: technickabezpecnost.cz → www (Google nevidí dvě verze webu;
# http://apex jde na https://www jedním skokem). Výjimka pro Let's Encrypt.
RewriteCond %{HTTP_HOST} ^technickabezpecnost\.cz$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://www.technickabezpecnost.cz%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Skryté soubory (.htaccess, .git…) nikdy nevydávat,
# ověřovací adresář Let's Encrypt zůstává dostupný
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F]

# Hezká adresa exportu administrace: /admin/export.csv → admin/export.php
# (/admin/ obslouží DirectoryIndex → admin/index.php)
RewriteRule ^admin/export\.csv$ admin/export.php [L]
</IfModule>

# Bezpečnostní hlavičky
<IfModule mod_headers.c>
Header unset X-Powered-By
Header always unset X-Powered-By
Header always set Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# HSTS – zapnuto při ostrém spuštění (HTTPS přes Let's Encrypt u Hostingeru
# funguje a obnovuje se automaticky; bez includeSubDomains, jen tento host)
Header always set Strict-Transport-Security "max-age=31536000"
# Hostinger dává souborům v assets/ cache 7 dní; HTML se proto ověřuje při
# každé návštěvě (ETag) a odkazy na CSS/JS/obrázky nesou otisk obsahu ?v=…
# (doplňuje scripts/build-deploy-hostinger.sh) – nová verze se stáhne hned.
<FilesMatch "\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

# Žádné výpisy adresářů
<IfModule mod_autoindex.c>
IndexIgnore *
</IfModule>
